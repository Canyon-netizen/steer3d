# -----------------------------------------------------------------------------
# Reasoning3D .gitignore
# -----------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
env/

# --- Node / Next.js / R3F ---
node_modules/
.next/
out/
dist/
build/
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
next-env.d.ts

# 本机临时 npm cache（我装依赖时为了绕开 root-owned cache 用的）
frontend_npm_cache/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs / runtime ---
*.log
logs/
.env
.env.local
.env.*.local
pip-wheel-cache/

# --- Secrets accidentally saved next to code ---
# Used by ``datasets/upload_to_hf.py``. If a token lands on disk it must not
# be committed. Rotate the token immediately if this ever fires.
*.token
.hf_token
hf_token.txt

# --- Big transient artifacts (前端 build 输出) ---
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# --- 用户可能临时放进去的 ---
*.tmp
*.bak
*.orig

# --- 部署 staging（重复 backend/examples/output/，只是 deploy 用的副本） ---
deploy_staging/
# --- Reasoning3D-specific ---
# Vendored three.js copies used to build the standalone HTML viewer.
backend/examples/output/vendor/

# Generated trajectory datasets live under ``datasets/`` (one folder per
# collector run, e.g. ``datasets/aime_qwen3_1p7b_32k_fp32/``). Each
# trajectory is ~220 MB (28 layers × 2048 dim × N tokens of float32 +
# full logits) and the full AIME corpus is ~13 GB. Use the collectors
# under ``backend/examples/`` to regenerate; keep these dirs local-only.
#
# Ignored: the raw ``aime/*.npz`` trajectory files (too big for git).
# Tracked: the ``viewer_cache/`` subfolder so the 3D viewer works out-
# of-the-box after a clone (each __layers.json is ≈17-23 MB, no single
# file >50 MB so plain git works, no LFS needed).
datasets/aime_qwen3_1p7b_32k_fp32/aime/
datasets/aime_qwen3_1p7b_32k_fp32/aime/**
datasets/aime_qwen3_1p7b_16k_fp16/aime/
datasets/aime_qwen3_1p7b_16k_fp16/aime/**

# Convenience cache that mirrors the trajectory datasets in viewer-ready
# form (one ``__layers.json`` per trajectory). Built by
# ``examples/build_per_layer.py``. Large enough to ignore per-machine.
backend/examples/output/viewer_cache/

# Symlinks pointing into datasets/ for legacy scripts that still hard-code
# the old output/ paths. Git follows symlinks only partially, so we
# ignore them outright.
backend/examples/output/datasets/

# Old trajectory folders under examples/output (pre-datasets/ move).
# These may now be symlinks pointing into datasets/ — git tracks neither.

# Per-layer 3-D projections, one small binary per (trajectory, layer) —
# thousands of files that are fully regenerable from datasets/ by
# examples/expand_global_data.py.
backend/examples/output/layer_xyz/

# Standalone viewer bundles and caches built by the terrain scripts.
backend/examples/output/token_terrain.html
backend/examples/output/live_terrain.html
backend/examples/output/view_terrain.html
backend/examples/output/view_standalone.html

# Locally-downloaded model weights.
datasets/models/

# 本地静态服务与浏览器审计的临时产物
.cache/

# 隐空间观察台的二进制数据包：80MB 的原始 hidden state，属交付物不属源码，
# 由 build_latent_bundle.py 重新生成。随网页一起分发，不进版本库。
frontend/public/latent/data/
frontend/public/latent/data06/
.cache/pylibs/

# 浏览器审计用的 Chrome profile 目录。`.cache/` 已经被忽略，但 `git add -f`
# 会绕过忽略规则——曾经 `git add -f .cache/arreadout/` 把 232 个 GPUCache /
# DawnGraphiteCache / Code Cache 文件一起提交了。强制添加时只点名脚本文件，
# 不要强制添加整个目录。
.cache/*/profile*/
.cache/*/cc/
.cache/*/dc/

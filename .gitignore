# -----------------------------------------------------------------------------
# Reasoning3D .gitignore
# -----------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/
env/

# --- Node / Next.js / R3F ---
node_modules/
.next/
out/
dist/
build/
.npm/
.yarn/
.pnp.*
*.tsbuildinfo
next-env.d.ts

# 本机临时 npm cache（我装依赖时为了绕开 root-owned cache 用的）
frontend_npm_cache/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs / runtime ---
*.log
logs/
.env
.env.local
.env.*.local
pip-wheel-cache/

# --- Big transient artifacts (前端 build 输出) ---
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# --- 用户可能临时放进去的 ---
*.tmp
*.bak
*.orig

# --- 部署 staging（重复 backend/examples/output/，只是 deploy 用的副本） ---
deploy_staging/
# --- Reasoning3D-specific ---
# Vendored three.js copies used to build the standalone HTML viewer.
backend/examples/output/vendor/

# Generated trajectory datasets live under ``datasets/`` (one folder per
# collector run, e.g. ``datasets/aime_qwen3_1p7b_32k_fp32/``). Each
# trajectory is ~220 MB (28 layers × 2048 dim × N tokens of float32 +
# full logits) and the full AIME corpus is ~13 GB. Use the collectors
# under ``backend/examples/`` to regenerate; keep these dirs local-only.
datasets/

# Convenience cache that mirrors the trajectory datasets in viewer-ready
# form (one ``__layers.json`` per trajectory). Built by
# ``examples/build_per_layer.py``. Large enough to ignore per-machine.
backend/examples/output/viewer_cache/

# Old trajectory folders under examples/output (pre-datasets/ move).
# These may now be symlinks pointing into datasets/ — git tracks neither.
backend/examples/output/trajectories_16k_fp16
backend/examples/output/trajectories_32k_fp32
